# PostgreSQL connection string
# Local:      postgresql://postgres:password@localhost:5432/agritrade_hub
# Neon/hosted: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/agritrade_hub

# JWT
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - comma separated frontend origins
FRONTEND_ORIGINS=http://localhost:5173
